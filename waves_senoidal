import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation

# Parâmetros da onda
amplitude = 1
frequencia = 0.2
velocidade = 1
comprimento = 2  * np.pi / frequencia

# Espaço e tempo
x = np.linspace(0, 4 * np.pi, 1000)
fig, ax = plt.subplots()
linha, = ax.plot(x, np.sin(x))

def atualiza(frame):
    y = amplitude * np.sin(frequencia * x - velocidade * frame * 0.1)
    linha.set_ydata(y)
    return linha,

ani = animation.FuncAnimation(fig, atualiza, frames=200, interval=30, blit=True)
plt.ylim(-2, 2)
plt.title("Simulação de onda do mar (Senoidal)")
plt.xlabel("Posição")
plt.ylabel("Altuura da onda")
plt.show()
